digraph G { graph [bgcolor="white"]; node [shape=plain fontname="Arial" fontsize=10]; c [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>SqliteIncidentRepository</B> (P3 DRAFT)</TD></TR><TR><TD ALIGN="LEFT">+ explicit SqliteIncidentRepository(SqliteConfiguration configuration);</TD></TR><TR><TD ALIGN="LEFT">+ ~SqliteIncidentRepository() override;</TD></TR><TR><TD ALIGN="LEFT">+ Result&lt;SaveReceipt&gt; save(const IncidentRecord&amp; record, Version expectedRecordVersion) override;</TD></TR><TR><TD ALIGN="LEFT">+ Result&lt;IncidentRecord&gt; load(const IncidentId&amp; id) const override;</TD></TR><TR><TD ALIGN="LEFT">+ Result&lt;std::vector&lt;IncidentRecord&gt;&gt; loadPending() const override;</TD></TR><TR><TD ALIGN="LEFT">+ Result&lt;DispatchReceipt&gt; claimDispatch(const IncidentId&amp; id, const AttemptId&amp; attempt, Version expectedRecordVersion, UtcTime now) override;</TD></TR><TR><TD ALIGN="LEFT">+ Result&lt;std::vector&lt;IncidentRecord&gt;&gt; history(std::size_t offset, std::size_t limit) const override;</TD></TR><TR><TD ALIGN="LEFT">+ SqliteIncidentRepository(const SqliteIncidentRepository&amp;) = delete;</TD></TR><TR><TD ALIGN="LEFT">+ SqliteIncidentRepository&amp; operator=(const SqliteIncidentRepository&amp;) = delete;</TD></TR><TR><TD ALIGN="LEFT">- SqliteConfiguration configuration_;</TD></TR><TR><TD ALIGN="LEFT">- sqlite3* database_;</TD></TR><TR><TD ALIGN="LEFT">- mutable std::mutex mutex_;</TD></TR></TABLE>>]; }