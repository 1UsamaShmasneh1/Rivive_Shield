{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RS-06 Item 3 BookingRequest wire contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "roomId",
    "startsAt",
    "endsAt",
    "label"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "roomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "startsAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "minLength": 24,
      "maxLength": 24
    },
    "endsAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "minLength": 24,
      "maxLength": 24
    },
    "label": {
      "type": "string",
      "maxLength": 128
    }
  },
  "description": "After decoding, require valid Unicode scalar values. Enforce the separate 8192-byte body limit and start-before-end rule outside this schema. Validate calendar and clock values explicitly."
}
